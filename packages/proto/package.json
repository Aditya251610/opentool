{
  "name": "@opentool/proto",
  "version": "0.1.1",
  "description": "Protocol Buffer definitions for OpenTool gRPC services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "proto:gen": "node scripts/generate.mjs"
  },
  "files": [
    "dist",
    "opentool"
  ],
  "dependencies": {
    "@grpc/grpc-js": "^1.13.0",
    "@grpc/proto-loader": "^0.7.15",
    "protobufjs": "^7.5.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  }
}
