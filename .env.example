# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opentool

# Redis
REDIS_URL=redis://localhost:6379

# Auth
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Encryption key for stored tokens (32 bytes hex)
TOKEN_ENCRYPTION_KEY=your-32-byte-hex-key-here

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Notion OAuth App
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Slack OAuth App
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Add remaining providers as you build them
