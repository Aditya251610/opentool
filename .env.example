# Database (Supabase or local PostgreSQL)
# Pooler for runtime (port 6543, transaction mode)
DATABASE_URL="postgresql://postgres.your-project:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct for migrations (port 5432)
DIRECT_URL="postgresql://postgres.your-project:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Redis
REDIS_URL=redis://localhost:6379

# Dashboard URL (for OAuth callback redirects)
DASHBOARD_URL=http://localhost:3000

# Server port
PORT=3001

# Encryption key for stored tokens (32 bytes hex)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Dashboard env (apps/dashboard/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:3001

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Notion OAuth App
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Slack OAuth App
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Google OAuth (shared for Gmail + GCal)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Linear OAuth
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Stripe OAuth
STRIPE_CLIENT_ID=
STRIPE_CLIENT_SECRET=

# Vercel OAuth
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=

# ─── New Providers ─────────────────────────

# GitLab OAuth App (https://gitlab.com/-/user_settings/applications)
# Scopes: api, read_user
# Callback: {SERVER_URL}/api/auth/callback/gitlab
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Optional: self-hosted GitLab instance
# GITLAB_BASE_URL=https://gitlab.com/api/v4

# Sentry Auth Token (https://sentry.io/settings/account/api/auth-tokens/)
# Scopes: project:read, event:read, org:read
SENTRY_AUTH_TOKEN=
# Optional: self-hosted Sentry instance
# SENTRY_BASE_URL=https://sentry.io/api/0

# Cloudflare API Token (https://dash.cloudflare.com/profile/api-tokens)
# Use "Edit zone DNS" template or custom with Zone/DNS permissions
CLOUDFLARE_API_TOKEN=

# PayPal OAuth App (https://developer.paypal.com/dashboard/applications)
# Callback: {SERVER_URL}/api/auth/callback/paypal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox  # "sandbox" for testing, "production" for live

# Docker Hub Access Token (https://hub.docker.com/settings/security)
# Optional — public repos work without auth
DOCKER_HUB_TOKEN=

# ─── Messaging Providers ──────────────────

# Telegram Bot Token (https://t.me/BotFather → /newbot)
TELEGRAM_BOT_TOKEN=

# Discord Bot Token (https://discord.com/developers/applications)
# Create app → Bot → Reset Token
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=

# Twilio (https://console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=  # e.g. whatsapp:+14155238886
TWILIO_SMS_FROM=        # e.g. +15551234567

# ─── Atlassian (Jira + Confluence) ────────

# Atlassian OAuth App (https://developer.atlassian.com/console/myapps/)
# Callback: {SERVER_URL}/api/auth/callback/jira (and /confluence)
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# ─── Microsoft (Outlook, Calendar, Teams) ─

# Azure AD App Registration (https://portal.azure.com → App registrations)
# Callback: {SERVER_URL}/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=  # Use "common" for multi-tenant

# ─── Cloud Providers ──────────────────────

# AWS (https://console.aws.amazon.com/iam → Security credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Azure Resource Management
# Uses same MICROSOFT_CLIENT_ID/SECRET above, plus:
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# GCP Service Account (https://console.cloud.google.com → IAM → Service Accounts)
# Create key → JSON → paste entire JSON or base64-encode it
GCP_SERVICE_ACCOUNT_KEY=
GCP_PROJECT_ID=

# ─── Monitoring ────────────────────────────

# Sentry error tracking (optional)
# Format: https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_DSN=

# gRPC server (optional — disabled by default)
GRPC_ENABLED=false
GRPC_PORT=50051
# TLS (required in production, optional in development)
GRPC_TLS_CERT=
GRPC_TLS_KEY=
# Mutual TLS (optional — for client certificate verification)
GRPC_TLS_CA=
GRPC_MAX_STREAMS=100
GRPC_REFLECTION=true