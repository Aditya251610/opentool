// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum AuthType {
  OAUTH2
  API_KEY
  NONE
}

enum ConnectionStatus {
  CONNECTED
  DISCONNECTED
  EXPIRED
  REVOKED
  PENDING_AUTH
}

enum AuditAction {
  TOOL_EXECUTE
  TOOL_AUTH_REQUEST
  TOOL_AUTH_SUCCESS
  TOOL_AUTH_FAILURE
  TOKEN_REFRESH
  TOKEN_REVOKE
  API_KEY_CREATED
  API_KEY_REVOKED
  // Org-related actions
  ORG_CREATED
  ORG_UPDATED
  ORG_DELETED
  ORG_MEMBER_INVITED
  ORG_MEMBER_JOINED
  ORG_MEMBER_REMOVED
  ORG_MEMBER_ROLE_CHANGED
  ORG_TEAM_CREATED
  ORG_TEAM_DELETED
  ORG_KEY_CREATED
  ORG_KEY_REVOKED
  ORG_TOOL_CONNECTED
  ORG_TOOL_DISCONNECTED
  ORG_SSO_CONFIGURED
  ORG_SSO_LOGIN
  PERMISSION_DENIED
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TeamRole {
  LEAD
  MEMBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum SsoProvider {
  GOOGLE_WORKSPACE
  OKTA
  AZURE_AD
  CUSTOM_SAML
  CUSTOM_OIDC
}

enum AuditStatus {
  SUCCESS
  FAILURE
  PENDING
}

// ─────────────────────────────────────────
// USER
// ─────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  apiKeys         ApiKey[]
  toolConnections ToolConnection[]
  auditLogs       AuditLog[]
  orgMemberships  OrgMembership[]
  teamMemberships TeamMembership[]

  @@index([email])
  @@map("users")
}

// ─────────────────────────────────────────
// API KEY
// Stored as SHA-256 hash — raw key shown once at creation only
// ─────────────────────────────────────────

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique
  keyPrefix  String // first 8 chars for display e.g. "ot_live_ab12..."
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
  @@map("api_keys")
}

// ─────────────────────────────────────────
// OAUTH PROVIDER
// Registered OAuth apps — one row per provider
// clientSecret stored encrypted
// ─────────────────────────────────────────

model OAuthProvider {
  id              String   @id @default(cuid())
  provider        String   @unique // "github" | "notion" | "slack" etc.
  displayName     String
  authUrl         String
  tokenUrl        String
  revokeUrl       String?
  clientId        String
  clientSecretEnc String // AES-256-GCM encrypted
  defaultScopes   String[]
  authType        AuthType @default(OAUTH2)
  isEnabled       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  toolDefinitions    ToolDefinition[]
  toolConnections    ToolConnection[]
  orgToolConnections OrgToolConnection[]

  @@index([provider])
  @@map("oauth_providers")
}

// ─────────────────────────────────────────
// TOOL DEFINITION
// The registry — one row per tool action
// e.g. "github_create_issue", "notion.query_database"
// ─────────────────────────────────────────

model ToolDefinition {
  id             String   @id @default(cuid())
  providerId     String
  toolId         String   @unique // "github_create_issue"
  name           String
  description    String
  inputSchema    Json // JSON Schema of tool inputs
  outputSchema   Json? // JSON Schema of tool output
  authType       AuthType @default(OAUTH2)
  requiredScopes String[]
  isEnabled      Boolean  @default(true)
  version        String   @default("1.0.0")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  provider  OAuthProvider @relation(fields: [providerId], references: [id])
  auditLogs AuditLog[]

  @@index([providerId])
  @@index([toolId])
  @@map("tool_definitions")
}

// ─────────────────────────────────────────
// TOOL CONNECTION
// Per-user connection to a provider
// One row per user per provider
// ─────────────────────────────────────────

model ToolConnection {
  id         String           @id @default(cuid())
  userId     String
  providerId String
  status     ConnectionStatus @default(PENDING_AUTH)
  scopes     String[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider   OAuthProvider @relation(fields: [providerId], references: [id])
  tokenStore TokenStore?

  @@unique([userId, providerId])
  @@index([userId])
  @@index([providerId])
  @@map("tool_connections")
}

// ─────────────────────────────────────────
// TOKEN STORE
// Separated from ToolConnection for clean rotation
// All token values AES-256-GCM encrypted at rest
// ─────────────────────────────────────────

model TokenStore {
  id                String    @id @default(cuid())
  connectionId      String    @unique
  accessTokenEnc    String // encrypted
  refreshTokenEnc   String? // encrypted, nullable for API key auth
  accessTokenExpiry DateTime?
  scopes            String[]
  tokenType         String    @default("Bearer")
  rawMetadata       Json? // provider-specific extras
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  connection ToolConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@map("token_stores")
}

// ─────────────────────────────────────────
// AUDIT LOG
// Immutable record of every tool execution and auth event
// ─────────────────────────────────────────

model AuditLog {
  id               String      @id @default(cuid())
  userId           String
  toolDefinitionId String?
  action           AuditAction
  status           AuditStatus
  durationMs       Int?
  inputSnapshot    Json? // sanitized input (no secrets)
  errorMessage     String?
  ipAddress        String?
  userAgent        String?
  // Token analytics fields
  clientName       String? // MCP client name (e.g. "cursor", "copilot-cli")
  responseSize     Int? // response body size in bytes
  inputTokens      Int? // tokens consumed by tool input
  outputTokens     Int? // tokens consumed by tool response
  schemaTokens     Int? // tokens consumed by tool schema definition
  totalTokens      Int? // sum of input + output + schema tokens
  createdAt        DateTime    @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolDefinition ToolDefinition? @relation(fields: [toolDefinitionId], references: [id])

  @@index([userId])
  @@index([toolDefinitionId])
  @@index([createdAt])
  @@index([clientName])
  @@map("audit_logs")
}

// ─────────────────────────────────────────
// ORGANIZATION
// Top-level entity for multi-tenancy
// ─────────────────────────────────────────

model Organization {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  avatarUrl      String?
  plan           String       @default("free") // free | pro | enterprise
  maxMembers     Int          @default(5)
  maxKeys        Int          @default(10)
  maxToolExec    Int          @default(1000) // per month
  ssoEnabled     Boolean      @default(false)
  ssoProvider    SsoProvider?
  ssoConfig      Json? // encrypted IdP metadata
  domainVerified String? // e.g. "acme.com"
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  memberships     OrgMembership[]
  teams           Team[]
  apiKeys         OrgApiKey[]
  toolConnections OrgToolConnection[]
  invites         OrgInvite[]
  auditLogs       OrgAuditLog[]
  policies        OrgPolicy[]
  ssoSessions     OrgSsoSession[]
  retentionPolicy DataRetentionPolicy?

  @@index([slug])
  @@map("organizations")
}

// ─────────────────────────────────────────
// ORG MEMBERSHIP
// Links users to organizations with a role
// ─────────────────────────────────────────

model OrgMembership {
  id        String   @id @default(cuid())
  orgId     String
  userId    String
  role      OrgRole  @default(MEMBER)
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
  @@map("org_memberships")
}

// ─────────────────────────────────────────
// TEAM
// Sub-group within an organization
// ─────────────────────────────────────────

model Team {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberships TeamMembership[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@map("teams")
}

// ─────────────────────────────────────────
// TEAM MEMBERSHIP
// Links users to teams with a team-level role
// ─────────────────────────────────────────

model TeamMembership {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_memberships")
}

// ─────────────────────────────────────────
// ORG API KEY
// Organization-scoped keys with granular scopes
// ─────────────────────────────────────────

model OrgApiKey {
  id          String    @id @default(cuid())
  orgId       String
  createdBy   String
  name        String
  keyHash     String    @unique
  keyPrefix   String // "ot_org_xxxx"
  scopes      String[] // ["tools:execute", "tools:read", "keys:manage"]
  ipAllowlist String[] // CIDR ranges (e.g. "10.0.0.0/8")
  rateLimit   Int       @default(1000) // requests per minute
  environment String    @default("production") // production | staging | development
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([keyHash])
  @@map("org_api_keys")
}

// ─────────────────────────────────────────
// ORG TOOL CONNECTION
// Shared OAuth connections at the org level
// ─────────────────────────────────────────

model OrgToolConnection {
  id          String           @id @default(cuid())
  orgId       String
  providerId  String
  status      ConnectionStatus @default(PENDING_AUTH)
  scopes      String[]
  connectedBy String // userId who initiated OAuth
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  org        Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  provider   OAuthProvider  @relation(fields: [providerId], references: [id])
  tokenStore OrgTokenStore?

  @@unique([orgId, providerId])
  @@index([orgId])
  @@index([providerId])
  @@map("org_tool_connections")
}

// ─────────────────────────────────────────
// ORG TOKEN STORE
// Encrypted tokens for org-level connections
// ─────────────────────────────────────────

model OrgTokenStore {
  id                String    @id @default(cuid())
  connectionId      String    @unique
  accessTokenEnc    String
  refreshTokenEnc   String?
  accessTokenExpiry DateTime?
  scopes            String[]
  tokenType         String    @default("Bearer")
  rawMetadata       Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  connection OrgToolConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@map("org_token_stores")
}

// ─────────────────────────────────────────
// ORG INVITE
// Pending invitations to join an organization
// ─────────────────────────────────────────

model OrgInvite {
  id        String       @id @default(cuid())
  orgId     String
  email     String
  role      OrgRole      @default(MEMBER)
  status    InviteStatus @default(PENDING)
  invitedBy String // userId
  token     String       @unique // crypto-random 32-byte base64url
  expiresAt DateTime
  createdAt DateTime     @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([email])
  @@index([token])
  @@map("org_invites")
}

// ─────────────────────────────────────────
// ORG POLICY
// Configurable rules and constraints per org
// ─────────────────────────────────────────

model OrgPolicy {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String?
  rules       Json
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
  @@index([orgId])
  @@map("org_policies")
}

// ─────────────────────────────────────────
// ORG AUDIT LOG
// Immutable org-scoped activity log
// ─────────────────────────────────────────

model OrgAuditLog {
  id            String      @id @default(cuid())
  orgId         String
  userId        String
  action        AuditAction
  status        AuditStatus
  resource      String?
  durationMs    Int?
  inputSnapshot Json?
  errorMessage  String?
  ipAddress     String?
  userAgent     String?
  orgContext    Json? // { teamId?, policyId?, keyId? }
  geoLocation   String? // country code from IP
  retainUntil   DateTime? // GDPR: scheduled deletion date
  createdAt     DateTime    @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([userId])
  @@index([createdAt])
  @@index([retainUntil])
  @@map("org_audit_logs")
}

// ─────────────────────────────────────────
// ORG SSO SESSION
// Tracks active SSO sessions for audit + forced logout
// ─────────────────────────────────────────

model OrgSsoSession {
  id           String   @id @default(cuid())
  orgId        String
  userId       String
  idpSessionId String // from SAML/OIDC provider
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, userId])
  @@index([expiresAt])
  @@map("org_sso_sessions")
}

// ─────────────────────────────────────────
// DATA RETENTION POLICY
// GDPR-compliant retention settings per org
// ─────────────────────────────────────────

model DataRetentionPolicy {
  id              String   @id @default(cuid())
  orgId           String   @unique
  auditLogDays    Int      @default(90)
  tokenStoreDays  Int      @default(365)
  deletedUserDays Int      @default(30)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("data_retention_policies")
}
